# Aplicacao
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
TIMEZONE=America/Sao_Paulo

# PostgreSQL externo (Supabase ou outro PostgreSQL)
# Nunca commitar a URL real.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Worker
WORKER_NAME=worker-1
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_AFTER_SECONDS=60
WORKER_POLL_MS=2000
DRY_RUN=true

# Seguranca - preencher somente no ambiente real
JWT_SECRET=
ENCRYPTION_KEY=

# IA - sera configurada em etapa propria
AI_PROVIDER=
AI_API_KEY=

# Storage - sera configurado em etapa propria
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# WhatsApp - credenciais por instancia ficarao no backend/banco de forma protegida
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_GO_BASE_URL=
EVOLUTION_GO_API_KEY=
